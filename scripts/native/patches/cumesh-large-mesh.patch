+static void memcpy_device_to_device_chunked(void* dst, const void* src, size_t bytes) {
+    constexpr size_t chunk_size = 4 * 1024 * 1024;
+    for (size_t offset = 0; offset < bytes; offset += chunk_size) {
+        const size_t remaining = bytes - offset;
+        const size_t count = remaining < chunk_size ? remaining : chunk_size;
+        CUDA_CHECK(cudaMemcpy(
+            static_cast<char*>(dst) + offset,
+            static_cast<const char*>(src) + offset,
+            count,
+            cudaMemcpyDeviceToDevice
+        ));
+    }
+}
