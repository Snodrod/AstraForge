# Set these in the environment before starting the application.
# This file is an example; the app does not load .env files automatically.
# API keys are optional and are normally entered in the app's Connections tab
# (stored encrypted with Windows DPAPI). Never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: path to an existing ComfyUI install (the installer writes config\paths.json otherwise).
# ASTRA_COMFY_DIR=C:/ComfyUI
PORT=3210
